# Configure the same new service-only random key on the worker and Aurora.
# Never use a provider key, Zalo password or Vault master key here.
AURORA_CLOUD_BROWSER_KEY=
DATA_DIR=/data
PORT=8080

# Aurora control plane only (not this worker):
# AURORA_CLOUD_BROWSER_URL=http://aurora-browser-worker.railway.internal:8080
# Docker Compose alternative: AURORA_CLOUD_BROWSER_URL=http://browser.aurora.internal:8080
