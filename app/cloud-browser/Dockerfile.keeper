FROM node:24-bookworm-slim

ENV NODE_ENV=production PORT=8080
WORKDIR /app
RUN groupadd --gid 10001 aurora \
    && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin aurora
COPY --chown=root:root vm-keeper.mjs /app/vm-keeper.mjs
USER 10001:10001
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD node -e "require('node:http').get({host:'127.0.0.1',port:process.env.PORT||8080,path:'/healthz'},r=>process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1))"
CMD ["node", "vm-keeper.mjs"]
